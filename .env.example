# Copy to .env and fill in. Never commit .env; it is in .gitignore.
#
# Local target
# Path to the smolvm binary. Defaults to "smolvm" on PATH. Only the local
# target needs it.
SMOLVM=
# Address of an already running "smolvm serve". If set and reachable, this
# server uses it and never stops it. Only one serve can run per host, so this
# is the escape hatch when something else already holds 127.0.0.1:10081.
# Forms: unix:///abs/path.sock or http://127.0.0.1:PORT (loopback only).
SMOL_LOCAL_URL=
# Where this server keeps its socket, log and ephemeral-machine state file.
# Must be short: a Unix socket path is limited to 104 bytes on macOS.
SMOL_MCP_RUNTIME_DIR=

# Which fleets this process serves: auto, local, cloud or both. auto is both
# when SMOL_CLOUD_TOKEN is set and local otherwise. In a single-target mode
# the `target` argument is not in any tool schema.
SMOL_MCP_TARGETS=

# Cloud target
SMOL_CLOUD_TOKEN=
SMOL_CLOUD_URL=https://api.smolmachines.com

# Tethered defaults, all optional. See the README for why each number is what
# it is; changing one here changes it for both targets.
SMOL_MCP_MEMORY_MB=
SMOL_MCP_CPUS=
SMOL_MCP_EXEC_TIMEOUT_SECS=
SMOL_MCP_MAX_OUTPUT_BYTES=
SMOL_MCP_READY_TIMEOUT_SECS=
SMOL_MCP_RUN_ONCE_NETWORK=
SMOL_MCP_EPHEMERAL_TTL_SECS=
SMOL_MCP_MACHINE_PREFIX=

# HTTP transport only
SMOL_MCP_HTTP_SESSION_IDLE_SECS=
SMOL_MCP_HTTP_ALLOWED_HOSTS=
SMOL_MCP_HTTP_ALLOWED_ORIGINS=
